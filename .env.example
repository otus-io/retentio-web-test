# Copy to .env or use .env.development.local to override dev defaults.
# `npm run dev` uses .env.development (see repo); Vitest does not.
VITE_API_URL=http://localhost:8080

# Playwright E2E (copy these into .env.local — gitignored)
E2E_USERNAME=webtest
E2E_PASSWORD=webtest
# Optional: E2E_API_URL=https://api.retentio.app:8443
